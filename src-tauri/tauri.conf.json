{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WispLingua",
  "version": "1.0.0",
  "identifier": "com.wisplingua.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "popup",
        "url": "index.html",
        "title": "WispLingua",
        "width": 460,
        "height": 280,
        "minWidth": 320,
        "minHeight": 180,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "focus": true,
        "visible": false,
        "center": false,
        "acceptFirstMouse": true
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "WispLingua — Settings",
        "width": 880,
        "height": 620,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Tray-resident LLM translator",
    "longDescription": "Cross-platform tray translator with hotkey-driven popup, pluggable LLM adapters, and OpenRouter support.",
    "publisher": "WispLingua",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1", "libxdo3"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "entitlements": null,
      "exceptionDomain": null
    }
  },
  "plugins": {}
}
